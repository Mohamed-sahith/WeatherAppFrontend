@namespace WeatherAppFrontend.Layout
@inherits LayoutComponentBase
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@using WeatherAppFrontend.Services
@using WeatherAppFrontend.Auth
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject MudBlazor.ISnackbar Snackbar
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<div>
    <main>
        <MudAppBar Elevation="2" Class="mud-appbar-fixed">
            <MudText Typo="Typo.h6" Class="ml-4">⛅WeatherApp</MudText>
            @if (!string.IsNullOrEmpty(userEmail) && !IsLoginOrRegisterPage)
            {
                <MudSpacer />

                <MudMenu Direction="Direction.BottomStart"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.BottomRight"
                         Class="user-info-glass custom-user-menu">

                    <ActivatorContent>
                        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Style="color: white; font-size: 2rem;" />
                        <MudText Typo="Typo.body2" Style="color: white; margin-left: 8px;">@userEmail</MudText>
                    </ActivatorContent>
                    <ChildContent>

                        <!-- Temporarily hidden old User Info option -->
                        <!-- <MudMenuItem OnClick="NavigateToUserInfo" Style="display: none;">
                            <MudText Typo="Typo.body1" Style="color: white;">User Info</MudText>
                        </MudMenuItem> -->

                        <MudMenuItem OnClick="NavigateToUserProfile">
                            <MudText Typo="Typo.body1" Style="color: white;">User Profile</MudText>
                        </MudMenuItem>
                        <MudMenuItem OnClick="Logout">
                            <MudText Typo="Typo.body1" Style="color: white;">Logout</MudText>
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            }
        </MudAppBar>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private string? userEmail;

    private bool IsLoginOrRegisterPage =>
        Navigation.Uri.Contains("login", StringComparison.OrdinalIgnoreCase) ||
        Navigation.Uri.Contains("register", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (AuthService == null || AuthProvider == null)
        {
            Console.WriteLine("AuthService or AuthProvider is null during initialization.");
            return;
        }
        await LoadUserEmail();
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        _ = LoadUserEmailAsync(authenticationStateTask);
    }

    private async Task LoadUserEmailAsync(Task<AuthenticationState> authenticationStateTask)
    {
        try
        {
            var authState = await authenticationStateTask;
            await LoadUserEmail();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnAuthenticationStateChanged: {ex.Message}");
            Snackbar.Add("An error occurred while updating authentication state.", Severity.Error);
        }
    }

    private async Task LoadUserEmail()
    {
        if (AuthProvider == null)
        {
            Console.WriteLine("AuthProvider is null in LoadUserEmail.");
            return;
        }
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        userEmail = authState.User?.Identity?.Name;
        if (string.IsNullOrEmpty(userEmail))
        {
            userEmail = await LocalStorage.GetItemAsync<string>("email");
        }
        StateHasChanged();
    }

    private void NavigateToUserProfile()
    {
        Navigation.NavigateTo("/userprofile");
    }

    private async Task Logout()
    {
        if (AuthService == null)
        {
            Console.WriteLine("AuthService is null during logout.");
            return;
        }
        await AuthService.Logout();
        if (AuthProvider is CustomAuthProvider customAuthProvider)
        {
            customAuthProvider.NotifyAuthChanged();
        }
        Navigation.NavigateTo("/login", forceLoad: true);
        Snackbar.Add("Logged out successfully.", Severity.Info);
    }

    private void NavigateToUserInfo()
    {
        Navigation.NavigateTo("/userinfo");
    }

    public void Dispose()
    {
        if (AuthProvider != null)
        {
            AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        }
    }
}

