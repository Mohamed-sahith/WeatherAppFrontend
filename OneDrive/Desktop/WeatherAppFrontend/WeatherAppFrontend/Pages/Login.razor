@page "/"
@using WeatherAppFrontend.Services
@using WeatherAppFrontend.Auth
@using WeatherAppFrontend.Models.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body, html {
        overflow-x: hidden;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .weather-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: linear-gradient(135deg, #1a237e 0%, #45277f 100%);
        overflow: hidden;
    }

    .glass-container {
        position: relative;
        z-index: 10;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        padding: 2.5rem;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
        }

    .weather-icon {
        font-size: 3rem !important;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 1rem;
    }

    .title-gradient {
        color: rgba(255, 255, 255, 0.95);
        font-weight: 600 !important;
        margin-bottom: 0.5rem;
    }

    .subtitle-text {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }

    .glass-input {
        background: rgba(255, 255, 255, 0.15) !important;
        backdrop-filter: blur(10px) !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        border-radius: 12px !important;
        color: rgba(255, 255, 255, 0.95) !important;
        transition: all 0.3s ease !important;
    }

        .glass-input:hover {
            background: rgba(255, 255, 255, 0.2) !important;
            border-color: rgba(255, 255, 255, 0.4) !important;
        }

        .glass-input:focus-within {
            background: rgba(255, 255, 255, 0.25) !important;
            border-color: rgba(255, 255, 255, 0.5) !important;
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1) !important;
        }

        .glass-input input::placeholder {
            color: rgba(255, 255, 255, 0.6) !important;
            transition: opacity 0.3s ease;
        }

        .glass-input input:focus::placeholder {
            opacity: 0;
        }

    .weather-button {
        background: rgba(255, 255, 255, 0.2) !important;
        backdrop-filter: blur(10px) !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        border-radius: 12px !important;
        color: rgba(255, 255, 255, 0.95) !important;
        font-weight: 600 !important;
        height: 50px !important;
        transition: all 0.3s ease !important;
        width: 100% !important;
    }

        .weather-button:hover {
            background: rgba(255, 255, 255, 0.3) !important;
            border-color: rgba(255, 255, 255, 0.4) !important;
            transform: translateY(-2px);
        }

        .weather-button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none !important;
        }

    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(5px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

        .loading-overlay.show {
            opacity: 1;
            visibility: visible;
        }

    .simple-loader {
        width: 40px;
        height: 40px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-top: 3px solid rgba(255, 255, 255, 0.9);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0%

    {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }

    }

    .loading-text {
        color: rgba(255, 255, 255, 0.9);
        font-size: 1rem;
        font-weight: 500;
        margin-top: 1rem;
    }

    .signin-link {
        color: rgba(255, 255, 255, 0.9) !important;
        text-decoration: none !important;
        font-weight: 600 !important;
        transition: all 0.3s ease;
        border-bottom: 1px solid transparent;
    }

        .signin-link:hover {
            color: rgba(255, 255, 255, 1) !important;
            border-bottom-color: rgba(255, 255, 255, 0.7);
        }

    .divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.2);
        margin: 2rem 0;
    }

    .mud-input {
        color: rgba(255, 255, 255, 0.95) !important;
    }

    .mud-input-adornment {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    .mud-progress-circular {
        color: rgba(255, 255, 255, 0.9) !important;
    }
</style>

<!-- Weather Background -->
<div class="weather-bg"></div>

<!-- Loading Overlay -->
<div class="loading-overlay @(isLoading ? "show" : "")" id="loadingOverlay">
    <div style="display: flex; flex-direction: column; align-items: center;">
        <div class="simple-loader"></div>
        <div class="loading-text">Signing you in...</div>
    </div>
</div>

<!-- Main Content -->
<div class="glass-container">
    <div class="glass-card">
        <!-- Header -->
        <div style="text-align: center; margin-bottom: 2rem;">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Class="weather-icon" />
            <MudText Typo="Typo.h4" Class="title-gradient">
                Welcome Back
            </MudText>
            <MudText Class="subtitle-text">
                Sign in to continue to WeatherApp
            </MudText>
        </div>

        <!-- Login Form -->
        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div style="margin-bottom: 1.5rem;">
                <MudTextField @bind-Value="loginModel.Email"
                              Placeholder="Email Address"
                              Variant="Variant.Outlined"
                              Class="glass-input"
                              Style="width: 100%;"
                              InputType="InputType.Email"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Adornment="Adornment.Start" />
            </div>

            <div style="margin-bottom: 2rem;">
                <MudTextField @bind-Value="loginModel.Password"
                              Placeholder="Password"
                              Variant="Variant.Outlined"
                              Class="glass-input"
                              Style="width: 100%;"
                              InputType="InputType.Password"
                              AdornmentIcon="@Icons.Material.Filled.VpnKey"
                              Adornment="Adornment.Start" />
            </div>

            <MudButton Variant="Variant.Filled"
                       ButtonType="ButtonType.Submit"
                       Disabled="@(!IsFormValid || isLoading)"
                       Class="weather-button">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                    <span>Signing In...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
                    <span>Sign In</span>
                }
            </MudButton>
        </EditForm>

        <!-- Footer -->
        <div class="divider"></div>
        <div style="text-align: center;">
            <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.7);">
                Don't have an account?
                <MudLink Href="/Register" Class="signin-link" Style="margin-left: 0.5rem;">
                    Create Account
                </MudLink>
            </MudText>
        </div>
    </div>
</div>

@code {
    private LoginRequest loginModel = new();
    private bool isLoading = false;
    private bool IsFormValid => !string.IsNullOrWhiteSpace(loginModel.Email) && !string.IsNullOrWhiteSpace(loginModel.Password);

    private async Task HandleLogin()
    {
        isLoading = true;
        StateHasChanged();

        // Simulate loading time for better UX
        await Task.Delay(1500);

        var success = await AuthService.Login(loginModel);

        isLoading = false;
        StateHasChanged();

        if (success)
        {
            Snackbar.Add("Login successful!", Severity.Success);
            ((CustomAuthProvider)AuthProvider).NotifyAuthChanged();
            Navigation.NavigateTo("/weather");
        }
        else
        {
            Snackbar.Add("Login failed. Please try again.", Severity.Error);
        }
    }

    [Inject]
    public ISnackbar Snackbar { get; set; }
}