@page "/userprofile"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Blazored.LocalStorage
@using WeatherAppFrontend.Services
@using Microsoft.JSInterop
@using WeatherAppFrontend.Layout
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject WeatherService WeatherService
@inject MudBlazor.ISnackbar Snackbar
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<style>
    .weather-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #1e2a78 0%, #3e2b5f 25%, #1e2a78 50%, #3e2b5f 75%, #1e2a78 100%);
        background-size: 400% 400%;
        animation: gradientBG 20s ease infinite;
        z-index: -1;
    }

    .glass-container {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(25px);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        padding: 2rem;
        margin: 2rem auto;
        max-width: 600px;
        color: white;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%; /* Ensure container takes full height */
        min-height: calc(100vh - rem); /* Adjust based on margin */
    }

    .favorite-item {
        background: rgba(255, 255, 255, 0.08);
        padding: 0.5rem 1rem;
        margin: 0.5rem 0;
        border-radius: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .favorite-item:hover {
            background: rgba(255, 255, 255, 0.15);
        }

    .search-container {
        margin-bottom: 1rem;
    }

    .email-icon {
        vertical-align: middle;
        margin-right: 0.5rem;
        margin-bottom: 0.2rem; /* Slightly move down for better alignment */
    }

    .button-container {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: auto; /* Push buttons to the bottom */
        padding: 0.5rem;
        background: inherit; /* Match glass-container background */
        border-radius: 8px;
    }

    .glass-input input {
        color: white !important; /* Ensure white text color for search box */
    }

    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }
</style>

<div class="weather-bg"></div>

<MudContainer Style="padding-top: 64px; position: relative; z-index: 10;">
    <div class="glass-container">
        <MudText Typo="Typo.h5">User Profile</MudText>
        <MudText Typo="Typo.body1">
            <MudIcon Icon="@GetIconForEmail()" Class="email-icon" /> Email: @email
        </MudText>
        <MudText Typo="Typo.h6" Style="margin-top: 1rem;"> Favorite Cities :</MudText>

        <div class="search-container">
            <MudTextField @bind-Value="searchTerm"
                          Placeholder="Search favorite cities..."
                          Variant="Variant.Outlined"
                          Class="glass-input"
                          Style="min-width: 200px; margin-bottom: 1rem;"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" />
        </div>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   OnClick="ToggleSort"
                   Style="margin-bottom: 1rem;">
            Sort: @(isAscending ? "A-Z" : "Z-A")
        </MudButton>

        @if (favorites?.Any() ?? false)
        {
            var filteredFavorites = favorites
            .Where(f => string.IsNullOrWhiteSpace(searchTerm) || f.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .OrderBy(f => f, isAscending ? StringComparer.OrdinalIgnoreCase : Comparer<string>.Create((a, b) => b.CompareTo(a)));

            @foreach (var city in filteredFavorites)
            {
                <div class="favorite-item">
                    <MudText Typo="Typo.body2" Class="me-2">City: @city</MudText>
                    <div class="d-flex align-center gap-2">
                        <MudButton OnClick="() => NavigateToWeather(city)"
                                   Variant="Variant.Outlined"
                                   Color="Color.Success"
                                   Size="Size.Small">
                            Go
                        </MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => RemoveFavorite(city)" />
                    </div>
                </div>
            }
        }
        else
        {
            <MudText Typo="Typo.body1" Style="color: rgba(255, 255, 255, 0.6);">No favorite cities added yet.</MudText>
        }
        <div class="button-container">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoBack">
                Back to Weather
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Logout">
                Logout
            </MudButton>
        </div>
    </div>
</MudContainer>

@code {
    private string? email;
    private List<string>? favorites;
    private string searchTerm = string.Empty;
    private bool isAscending = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            email = authState.User?.Identity?.Name ?? await LocalStorage.GetItemAsync<string>("email");
            if (email == null)
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
            favorites = await WeatherService.GetUserFavorites(email) ?? new List<string>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"OnInitializedAsync error: {ex.Message}");
            Snackbar.Add("An error occurred while loading profile.", Severity.Error);
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    private async Task RemoveFavorite(string city)
    {
        try
        {
            if (email != null && !string.IsNullOrEmpty(city))
            {
                await WeatherService.RemoveCityFromFavorites(city);
                favorites?.Remove(city);
                Snackbar.Add($"Removed {city} from favorites!", Severity.Success);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"RemoveFavorite error: {ex.Message}");
            Snackbar.Add("Failed to remove city from favorites.", Severity.Error);
        }
    }

    private void NavigateToWeather(string city)
    {
        Navigation.NavigateTo($"/weather?city={Uri.EscapeDataString(city)}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/weather");
    }

    private void ToggleSort()
    {
        isAscending = !isAscending;
        StateHasChanged();
    }

    private string GetIconForEmail()
    {
        if (string.IsNullOrEmpty(email)) return Icons.Material.Filled.Person;
        char firstLetter = email[0];
        return firstLetter switch
        {
            'A' or 'B' or 'C' => Icons.Material.Filled.Cloud,
            'D' or 'E' or 'F' => Icons.Material.Filled.WbSunny,
            'G' or 'H' or 'I' => Icons.Material.Filled.WaterDrop,
            'J' or 'K' or 'L' => Icons.Material.Filled.Air,
            'M' or 'N' or 'O' => Icons.Material.Filled.Thermostat,
            'P' or 'Q' or 'R' => Icons.Material.Filled.LocationOn,
            'S' or 'T' or 'U' => Icons.Material.Filled.Home,
            'V' or 'W' or 'X' => Icons.Material.Filled.WaterDrop,
            'Y' or 'Z' => Icons.Material.Filled.Map,
            _ => Icons.Material.Filled.Person
        };
    }

    private async Task Logout()
    {
        try
        {
            await LocalStorage.RemoveItemAsync("authToken");
            await LocalStorage.RemoveItemAsync("email");
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logout error: {ex.Message}");
            Snackbar.Add("An error occurred during logout.", Severity.Error);
        }
    }
}