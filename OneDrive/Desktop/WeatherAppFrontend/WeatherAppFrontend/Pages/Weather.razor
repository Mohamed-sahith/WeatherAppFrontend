    public class GeoCityResult
    {
        public string Name { get; set; } = default!;
        public string Country { get; set; } = default!;
        public string State { get; set; } = default!;
        public double Lat { get; set; }
        public double Lon { get; set; }

        public override string ToString() => $"{Name}, {State}, {Country}";
    }

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("weather.razor OnInitializedAsync started.");
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        Console.WriteLine($"Token found: {token != null}");

        if (string.IsNullOrWhiteSpace(token))
        {
            Console.WriteLine("No token, redirecting to /login.");
            Navigation.NavigateTo("/login", true);
            return;
        }

        isAuthorized = true;
        Console.WriteLine("Authorization set to true.");

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        email = authState.User.Identity?.Name;
        if (string.IsNullOrEmpty(email))
        {
            email = await LocalStorage.GetItemAsync<string>("email");
            Console.WriteLine($"Email from localStorage: {email}");
        }

        if (!string.IsNullOrEmpty(email))
        {
            favorites = await WeatherService.GetUserFavorites(email);
            Console.WriteLine($"Favorites loaded: {string.Join(", ", favorites)}");
        }

        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["city"] != null)
        {
            city = query["city"];
            SelectedCity = new GeoCityResult { Name = city };
            await GetWeatherForecastAsync(city);
        }
        Console.WriteLine("weather.razor OnInitializedAsync completed.");
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && SelectedCity != null)
        {
            await GetWeatherForecastAsync(SelectedCity.Name);
        }
    }

